# Project LOOP - Environment Variables Configuration (Part 2)

# PostgreSQL Database URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_loop?schema=public"

# Auth & Session Secret (JWT / Cookie Encryption Key)
AUTH_SECRET="your-super-secret-32-byte-hex-or-jwt-key-here"

# Public App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI API Key (Server-side AI Sentiment & Theme Intelligence Layer)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Next.js Environment Mode
NODE_ENV="development"
